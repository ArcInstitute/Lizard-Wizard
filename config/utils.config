import java.time.*
Date now = new Date()

manifest {
    name = "Lizard-Wizard"
    author = "Arc Institute Multiomics Team"
    homePage = "https://github.com/ArcInstitute/Lizard-Wizard"
    description = "Calcium image processing Nextflow pipeline (CaImAn + Cellpose + Wizards Staff)"
    version = "0.1.0"
}

params {
    timestamp = now.format("yyyy-MM-dd_HH-mm-ss")
}

// Define a portable default for singularity_path early to avoid startup warnings
params.singularity_path = (params.singularity_path ?: (System.getenv('LZW_SINGULARITY_PATH') ?: "$PWD/singularity"))


// Email notifications (nextflow run ... -N you@example.com).
// Defaults point at Arc's internal SMTP relay so internal runs keep working.
// External users must point these at their own relay, e.g.:
//   export LZW_MAIL_FROM="you@example.com"
//   export LZW_SMTP_HOST="smtp.your-institution.edu"
//   export LZW_SMTP_PORT=587
// If you do not set up SMTP, simply omit `-N` and the pipeline still runs.
mail {
    from      = (System.getenv('LZW_MAIL_FROM') ?: "multi-omics@arcinstitute.org")
    smtp.host = (System.getenv('LZW_SMTP_HOST') ?: "chimera-admin")
    smtp.port = (System.getenv('LZW_SMTP_PORT') ?: 25) as Integer
}
