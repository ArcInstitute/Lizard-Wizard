profiles {
    conda {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false

        // Bind /dev/shm explicitly so CAIMAN can stage its memmap on the
        // node-local RAM disk (default auto-mounts vary across Singularity versions).
        singularity.runOptions = '-B /tmp:/tmp -B /dev/shm:/dev/shm'
        singularity.envWhitelist = 'XDG_CACHE_HOME,MPLCONFIGDIR,NUMBA_CACHE_DIR,FONTCONFIG_PATH,TMPDIR,TMP,HDMF_CACHE_DIR,PYNWB_CACHE_DIR'

        process {
            withLabel: caiman_env { 
                container = { "${params.singularity_path}/caiman.sif" } 
            }
            withLabel: cellpose_env { 
                container = { "${params.singularity_path}/cellpose.sif" }
                containerOptions = '--home $PWD'
            }
            withLabel: summary_env { 
                container = { "${params.singularity_path}/summary.sif" } 
            }
            withLabel: wizards_staff_env { 
                container = { "${params.singularity_path}/wizards_staff.sif" } 
                containerOptions = '--home $PWD --writable-tmpfs'
            }
        }
    }
    // [ARC INTERNAL] Convenience profile for Arc's Chimera HPC. It calls
    // getWorkDir() (resolves to /scratch/<group>/<user>/...), which only exists
    // on Chimera. External users should NOT use this profile; use
    // `-profile singularity` plus your own `-work-dir` instead.
    chimera_singularity {
        workDir                = getWorkDir()
        cache                  = "lenient"
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }
    docker {
        docker.enabled         = true
        docker.sudo            = false
        docker.runOptions      = "-u \$(id -u):\$(id -g) --platform=linux/amd64"
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    // -------------------------------------------------------------------------
    // [ARC INTERNAL] Maintainer test profiles.
    // The dev_* profiles point at Arc-only test data under /large_storage and
    // will NOT work outside Arc. External users wanting a no-data smoke test
    // should use `--simulate true` instead (see the README "Local" section).
    // -------------------------------------------------------------------------
    dev_zeiss_3d {
        params.input_dir        = "/large_storage/multiomics/projects/lizard_wizard/test_data/zeiss-3d/2024-04-17/Baseline"
        params.output_dir       = "/large_storage/multiomics/projects/lizard_wizard/test_output/zeiss-3d/"
        params.file_type        = "zeiss"
        params.test_image_names = "2024_04_17_SpheroidCalciumImaging_Baseline-01(1),2024_04_17_SpheroidCalciumImaging_Baseline-01(2)"
        params.llm              = "gpt-4o-mini"
    }
    dev_moldev_3d {
        params.input_dir        = "/large_storage/multiomics/projects/lizard_wizard/test_data/moldev-3d/Calcium_AAV-GCAMP_6wk_20240416/10xGCaMP-6wk-Baseline-Stream/80"
        params.output_dir       = "/large_storage/multiomics/projects/lizard_wizard/test_output/moldev-3d/"
        params.file_type        = "moldev"
        params.test_image_names = "10xGCaMP-6wk-Baseline-Stream_Stream_F08_s1_FITC,10xGCaMP-6wk-Baseline-Stream_Stream_D10_s1_FITC"
        params.llm              = "gpt-4o-mini"
    }
    dev_moldev_2d {
        params.input_dir        = "/large_storage/multiomics/projects/lizard_wizard/test_data/moldev-2d/Jay"
        params.output_dir       = "/large_storage/multiomics/projects/lizard_wizard/test_output/moldev-2d/"
        params.file_type        = "moldev"
        params.test_image_names = "20240628- 5wk CoCul B-D 4AP aB_Stream_B08_s3_FITC,20240628- 5wk CoCul B-D 4AP aB_Stream_B08_s1_FITC"
        params.use_2d           = true
        params.llm              = "gpt-4o-mini"
    }
    dev_moldev_2d_sim {
        params.output_dir     = "/large_storage/multiomics/projects/lizard_wizard/test_output/moldev-2d_sim"
        params.file_type      = "moldev"
        params.simulate       = true
        params.llm            = "gpt-4o-mini"
    }
    // [ARC INTERNAL] Site defaults for Arc's Chimera HPC. getWorkDir() resolves
    // to /scratch/<group>/<user>/nextflow-work/lizard-wizard and
    // getCondaCacheDir() to /home/<user>/nextflow/conda-cache/lizard-wizard
    // (see nextflow.config). Both paths only exist on Chimera, so external users
    // should NOT use this profile.
    chimera {
        workDir               = getWorkDir()
        conda.cacheDir        = getCondaCacheDir()
        cache                 = "lenient"
    }
    vm {
        process.errorStrategy = "terminate"
        process.maxRetries    = 0
        params.max_cpus       = 24
        params.max_memory     = "64.GB"
        params.max_time       = "72.h"
    }
    // [ARC INTERNAL] SLURM defaults tuned for Arc's Chimera cluster. The queue
    // name (`cpu_batch_high_mem`) and the 80-CPU / 900 GB clamps are
    // Chimera-specific and WILL fail on other clusters that do not have a queue
    // by that name or nodes that large. External SLURM users should use the
    // `slurm_generic` profile below and override the resource clamps/queue, or
    // copy this block and edit `process.queue`, `params.max_cpus`, and
    // `params.max_memory` to match their site.
    slurm {
        process.executor      = "slurm"
        // cpu_batch_high_mem: non-preemptible, 144c / 1.15TB per node, up to 14-day max time.
        // Avoids the 10s-grace-period kills of cpu_preemptible while still fitting our 48h max_time
        // and the retry-based time multipliers in config/process.config.
        process.queue         = "cpu_batch_high_mem"
        process.errorStrategy = "retry"  // "terminate"
        process.maxRetries    = 2
        executor.queueSize    = 200
        params.max_cpus       = 80
        params.max_memory     = "900.GB"
        params.max_time       = "48.h"
    }
    // Generic SLURM profile for any institutional HPC. Does NOT hard-code a
    // queue/partition name or oversized resource clamps. Override the defaults
    // for your site, e.g.:
    //   --slurm_queue <your_partition> --max_cpus 32 --max_memory 128.GB
    // Leaving `slurm_queue` empty lets SLURM pick the cluster default partition.
    slurm_generic {
        process.executor      = "slurm"
        process.queue         = params.slurm_queue ?: null
        process.errorStrategy = "retry"
        process.maxRetries    = 2
        executor.queueSize    = 100
        // Conservative defaults; raise to match your nodes via --max_cpus / --max_memory.
        // CLI flags (e.g. --max_cpus 32) override these.
        params.max_cpus       = 16
        params.max_memory     = "120.GB"
        params.max_time       = "48.h"
    }
    // Cloud: GCP Batch. Defaults below are Arc's project/region/bucket so Arc
    // runs keep working; external users MUST override them, e.g.:
    //   --gcp_project my-project --gcp_region us-central1 \
    //   --gcp_workdir gs://my-bucket/lizard-wizard-work
    // (or export GCP_PROJECT / GCP_REGION / GCP_WORKDIR; see nextflow.config).
    gcp {
        workDir               = params.gcp_workdir
        process.executor      = "google-batch"
        process.errorStrategy = "retry"
        process.maxRetries    = 3
        process.scratch       = true
        params.max_cpus       = 36
        params.max_memory     = "800.GB"
        params.max_time       = "72.h"
        google.project        = params.gcp_project
        google.location       = params.gcp_region
    }
    // Cloud: AWS Batch. There are NO real Arc defaults here; every value below
    // is a placeholder you must replace with your own AWS resources, e.g.:
    //   --aws_region us-east-1 \
    //   --aws_workdir s3://my-bucket/lizard-wizard-work \
    //   --aws_queue my-batch-job-queue
    // See the README "AWS Batch" section and nf-core's AWS Batch guide for the
    // IAM roles, compute environment, and job queue setup this profile expects.
    awsbatch {
        workDir               = params.aws_workdir
        process.executor      = "awsbatch"
        process.queue         = params.aws_queue
        process.errorStrategy = "retry"
        process.maxRetries    = 3
        params.max_cpus       = 16
        params.max_memory     = "120.GB"
        params.max_time       = "72.h"
        aws.region            = params.aws_region
        // Path to the AWS CLI *inside* your Batch container image. The nf-core
        // default AMI/image places it at /home/ec2-user/miniconda/bin/aws.
        aws.batch.cliPath     = params.aws_cli_path
    }
    report {
        report.enabled   = true
        report.overwrite = true
        report.file      = "${params.output_dir}/nf-report/${params.timestamp}.html"
    }
    trace {
        trace.enabled   = true
        trace.overwrite = true
        trace.file      = "${params.output_dir}/nf-trace/${params.timestamp}.txt"
        trace.fields    = "task_id,hash,native_id,name,status,exit,submit,container,cpus,time,disk,memory,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir,scratch"
    }
}


